# ══════════════════════════════════════════════════════════════════
# PlotsnHomes — PRODUCTION environment (Hostinger)
# Copy these into hPanel → your Node.js app → Environment variables.
# Do NOT commit a filled-in copy of this file.
# ══════════════════════════════════════════════════════════════════

# ── Database (MySQL on Hostinger) ─────────────────────────────────
# hPanel → Databases → MySQL Databases → create DB + user, then:
#   mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
# URL-encode special characters in the password (@ → %40, # → %23, etc.).
DATABASE_URL="mysql://u123456_brick:CHANGE_ME@localhost:3306/u123456_plotsnhomes"

# ── NextAuth ──────────────────────────────────────────────────────
# NEXTAUTH_URL must be your live https domain — no trailing slash.
NEXTAUTH_URL="https://yourdomain.com"
# Generate a long random secret. PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
NEXTAUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXT_PUBLIC_APP_NAME="PlotsnHomes"

# ══════════════════════════════════════════════════════════════════
# RAZORPAY — Primary payment gateway (INR / Indian users)
# Use LIVE keys for production: Dashboard → Settings → API Keys.
# NEXT_PUBLIC_RAZORPAY_KEY_ID must equal RAZORPAY_KEY_ID.
# ══════════════════════════════════════════════════════════════════
RAZORPAY_KEY_ID="rzp_live_XXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="XXXXXXXXXXXXXXXXXXXXXXXXXXXX"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_XXXXXXXXXXXX"
# Dashboard → Webhooks → add https://yourdomain.com/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=""

# ══════════════════════════════════════════════════════════════════
# STRIPE — Optional fallback (international / USD)
# https://dashboard.stripe.com/apikeys  (live keys)
# Webhook: https://yourdomain.com/api/webhooks/stripe  (checkout.session.completed)
# ══════════════════════════════════════════════════════════════════
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ══════════════════════════════════════════════════════════════════
# Email — Resend (https://resend.com/api-keys)
# Verify your sending domain in Resend before going live.
# Without a key, emails are logged to Admin → Emails instead of sent.
# ══════════════════════════════════════════════════════════════════
RESEND_API_KEY="re_..."
EMAIL_FROM="PlotsnHomes <noreply@yourdomain.com>"

# ── Live currency rates (optional) — https://www.xe.com/xecurrencydata/ ──
XE_ACCOUNT_ID=""
XE_API_KEY=""

# ── WhatsApp Business Cloud API (optional) ────────────────────────
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v22.0"
