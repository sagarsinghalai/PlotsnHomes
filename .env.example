# Database
DATABASE_URL="file:./dev.db"

# NextAuth — generate: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Credentials encryption (AES-256-GCM) for stored integration secrets
# (Meta Page Access Token / App Secret / Verify Token, portal webhook keys, …).
# Generate a 32-byte hex key: openssl rand -hex 32
# Required in production; without it, integration credentials cannot be stored.
CREDENTIALS_ENC_KEY="change-me-generate-with-openssl-rand-hex-32"

# ══════════════════════════════════════════════════════
# RAZORPAY — Primary payment gateway (INR / Indian users)
# ══════════════════════════════════════════════════════
# 1. Sign up → https://dashboard.razorpay.com
# 2. Settings → API Keys → Generate Test Key
# 3. Paste BOTH key_id and key_secret below
# 4. NEXT_PUBLIC_RAZORPAY_KEY_ID must equal RAZORPAY_KEY_ID
# 5. Restart dev server: npm run dev
RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="XXXXXXXXXXXXXXXXXXXXXXXXXXXX"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXX"
# Webhook secret (Dashboard → Webhooks → add URL /api/webhooks/razorpay):
RAZORPAY_WEBHOOK_SECRET=""

# ══════════════════════════════════════════════════════
# STRIPE — Optional fallback (international / USD)
# ══════════════════════════════════════════════════════
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ══════════════════════════════════════════════════════
# Email (optional — without key, emails log to Admin → Emails)
# ══════════════════════════════════════════════════════
# Resend — https://resend.com/api-keys
RESEND_API_KEY="re_..."
EMAIL_FROM="PlotsnHomes <onboarding@resend.dev>"

# XE.com live currency rates — https://www.xe.com/xecurrencydata/
XE_ACCOUNT_ID=""
XE_API_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_APP_NAME="PlotsnHomes"

# WhatsApp Business Cloud API Settings
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
